---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import { SECTIONS } from '../../data/site';

export function getStaticPaths() {
  return Object.keys(SECTIONS).map((section) => ({ params: { section } }));
}

const section = SECTIONS[Astro.params.section!];
const places = await getCollection('places');
const groups = section.groups
  .map((g) => ({ ...g, places: places.filter((p) => p.data.category === g.cat).sort((a, b) => a.data.name.localeCompare(b.data.name)) }))
  .filter((g) => g.places.length);
---
<Base title={section.title} description={section.intro}>
  <section class="section wrap">
    <p class="eyebrow">Explore</p>
    <h1>{section.title}</h1>
    <p class="muted" style="max-width:60ch">{section.intro}</p>
    {groups.map((g) => (
      <div class="group">
        {groups.length > 1 && <h2>{g.heading}</h2>}
        <div class="grid">{g.places.map((p) => <PlaceCard place={p} />)}</div>
      </div>
    ))}
  </section>
</Base>

<style>
  .group { margin-top: 40px; }
  .group h2 { padding-bottom: 8px; border-bottom: 2px solid var(--cobalt); }
</style>
